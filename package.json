{
  "name": "read-clip",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "metadata": "node scripts/generate-metadata.mjs",
    "predev": "npm run metadata",
    "dev": "astro dev",
    "prebuild": "npm run metadata",
    "build": "astro check && astro build && pagefind --site dist --output-subdir _pagefind",
    "preview": "astro preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "precheck": "npm run metadata",
    "check": "astro check && vitest run"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.62.1",
    "pagefind": "^1.5.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
