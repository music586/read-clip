---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getPublicClips } from '../../lib/clips';
import { formatDate } from '../../lib/date';
import { groupBySource } from '../../lib/sources';
import { withBase } from '../../lib/urls';

const groups = groupBySource(await getPublicClips());
---

<SiteLayout title="来源" description="按书籍和文章来源浏览公开阅读摘抄。" canonicalPath="/sources/">
  <section class="page-heading">
    <p class="eyebrow">SOURCES</p>
    <h1>来源</h1>
    <p>一座由书与文章组成的小书架。</p>
  </section>
  <ul class="source-grid">
    {groups.map((group) => (
      <li>
        <a href={withBase(`/sources/${group.key}/`)}>
          <span class="book-mark" aria-hidden="true"></span>
          <span><strong>{group.source}</strong>{group.author && <small>{group.author}</small>}</span>
          <span class="source-stats">{group.count} 条 · 最近 {formatDate(group.latestAt)}</span>
        </a>
      </li>
    ))}
  </ul>
</SiteLayout>
