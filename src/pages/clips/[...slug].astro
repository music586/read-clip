---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { clipPath, excerpt, getClips, type ClipEntry } from '../../lib/clips';
import { formatDate } from '../../lib/date';
import { tagPath } from '../../lib/tags';
import { withBase } from '../../lib/urls';

export const getStaticPaths = (async () => {
  const clips = await getClips();
  return clips.map((clip) => ({ params: { slug: clip.id }, props: { clip } }));
}) satisfies GetStaticPaths;

interface Props { clip: ClipEntry }
const { clip } = Astro.props;
const { Content } = await render(clip);
const canonicalPath = clipPath(clip.id);
---

<SiteLayout title={clip.data.title} description={excerpt(clip.body ?? '', 160)} canonicalPath={canonicalPath}>
  <div class="clip-detail">
    <nav class="breadcrumbs" aria-label="面包屑导航" data-pagefind-ignore>
      <ol>
        <li><a href={withBase('/')}>首页</a></li>
        <li><a href={withBase('/tags/')}>分类</a></li>
      </ol>
    </nav>
    <header class="detail-header">
      <h1 data-pagefind-meta="title">{clip.data.title}</h1>
      <div class="clip-meta detail-meta">
        <time datetime={clip.data.createdAt} title="创建时间">{formatDate(clip.data.createdAt)}</time>
      </div>
      {clip.data.tags.length > 0 && (
        <nav class="detail-tags" aria-label="文章标签" data-pagefind-ignore>
          <ul class="tag-list">{clip.data.tags.map((tag) => <li><a href={withBase(tagPath(tag))}>{tag}</a></li>)}</ul>
        </nav>
      )}
    </header>
    <article class="prose" data-pagefind-body><Content /></article>
  </div>
  <dialog class="image-preview" aria-label="图片预览">
    <button class="image-preview-close" type="button" aria-label="关闭图片预览"></button>
    <img alt="" />
  </dialog>
</SiteLayout>

<script>
  const preview = document.querySelector<HTMLDialogElement>('.image-preview');
  const previewImage = preview?.querySelector<HTMLImageElement>('img');
  const closeButton = preview?.querySelector<HTMLButtonElement>('.image-preview-close');
  const articleImages = document.querySelectorAll<HTMLImageElement>('.prose img');
  let triggerImage: HTMLImageElement | null = null;

  const closePreview = () => preview?.close();

  const openPreview = (image: HTMLImageElement) => {
    if (!preview || !previewImage) return;
    triggerImage = image;
    previewImage.src = image.currentSrc || image.src;
    previewImage.alt = image.alt;
    preview.showModal();
    document.body.classList.add('preview-open');
  };

  articleImages.forEach((image) => {
    image.tabIndex = 0;
    image.setAttribute('role', 'button');
    image.setAttribute('aria-label', image.alt ? `预览图片：${image.alt}` : '预览图片');
    image.addEventListener('click', () => openPreview(image));
    image.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      openPreview(image);
    });
  });

  closeButton?.addEventListener('click', closePreview);
  preview?.addEventListener('click', (event) => {
    if (event.target === preview) closePreview();
  });
  preview?.addEventListener('close', () => {
    document.body.classList.remove('preview-open');
    previewImage?.removeAttribute('src');
    triggerImage?.focus();
    triggerImage = null;
  });
</script>
